# Copy to .env. Never commit .env — it names the admin token.

# Gates the admin UI and every key/client management endpoint. Without it the
# gateway still serves inference but refuses to let anyone change keys.
#   openssl rand -hex 32
ADMIN_TOKEN=

# Where keys, client tokens and the usage ledger live. A file by default; mount
# a volume at this path or the keys vanish with the container.
DATABASE_URL=/data/gateway.db

# Upstream provider. Only change this to point at a compatible proxy.
UPSTREAM_URL=https://openrouter.ai/api/v1/chat/completions
DEFAULT_MODEL=openrouter/free

REST_PORT=8080
GRPC_PORT=50051
REQUEST_TIMEOUT=45
